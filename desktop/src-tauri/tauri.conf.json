{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XRML Research Agent",
  "version": "0.1.0",
  "identifier": "com.xrml.research-agent",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/xrml-sidecar"],
    "resources": {"binaries/sidecar-runtime/": "sidecar-runtime/"},
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
