AUTH_MODE=disabled
# Leave disabled for local/internal development only. Shared/staging/production must use AUTH_MODE=oidc.
# Canonical environment contract: docs/PRODUCTION_ENVIRONMENT.md
# OIDC requires an explicit non-placeholder value of at least 32 UTF-8 bytes.
SESSION_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
# ChatGPT Developer Mode remote MCP requires AUTH_MODE=oidc and a public HTTPS APP_BASE_URL.
WEB_APP_BASE_PATH=/app
XRML_ENVIRONMENT=local
XRML_DEPLOYMENT_PROFILE=single-service
XRML_STRICT_ENV_VALIDATION=false
LOG_FORMAT=plain
LOG_LEVEL=INFO
# Optional local override. Leave empty to keep runtime data under the repo's storage/ directory.
XRML_DATA_DIR=
COOKIE_SECURE=
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false
ALLOWED_ORIGINS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
# OIDC_AUDIENCE is required for MCP bearer-token audience validation in shared/OIDC mode.
# Empty: use Settings > Model connections (initial default: Codex subscription CLI).
# Explicit overrides, e.g. disabled / codex_cli / openai / xai, take precedence.
# Selection never enables a model call or grants execution authority.
XRML_PROVIDER=
OPENAI_API_KEY=
XAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45
# Collection providers currently supported by the product provider registry:
# arXiv, OpenAlex, and Crossref do not require secrets in this release.
# Providers beyond the implemented set remain gated until real collectors exist.

# Notification delivery channels. Leave blank to keep email honestly unavailable in the UI.
# SMTP is available only when host/from/port validate. Username and password must be set together.
# TLS and SSL are mutually exclusive.
# Runtime readiness states: available, unavailable_missing_env, invalid_config, connection_failed, delivery_failed.
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SMTP_TLS=true
NOTIFICATION_EMAIL_SMTP_SSL=false
NOTIFICATION_EMAIL_SMTP_USERNAME=
NOTIFICATION_EMAIL_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
# Webhook egress is fail-closed: explicit enablement and an exact-host allowlist are both required.
# Host entries are comma-separated FQDNs. Wildcards, IP literals, HTTP, redirects, and proxy-env routing are rejected.
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=
NOTIFICATION_WEBHOOK_ALLOWED_PORTS=443
# Destination URLs are configured through notification settings. Keep query secrets out of logs and release packages.

# Secret-safe production activation checks:
# powershell -ExecutionPolicy Bypass -File scripts\check-production-activation.ps1 -Strict -RequireOidc
# powershell -ExecutionPolicy Bypass -File scripts\check-production-activation.ps1 -Strict -RequireOidc -RequireSmtp
# Classification: OIDC/SMTP are FULLY_REAL only when the corresponding env validates.
# Missing OIDC/SMTP env is intentionally unavailable/gated, never fake-ready.

# Automation scheduler runtime.
# Supported values: embedded, external, disabled.
# embedded keeps the app-local worker; external requires running `python -m app.jobs.topic_schedule_worker`.
TOPIC_SCHEDULER_MODE=embedded
# Scheduler persistence backend.
# Supported values: single_node_file_backed, db_backed, queue_backed.
# db_backed uses the repo SQLite scheduler DB for competing local workers/processes.
# queue_backed adds durable SQLite queue items and automation_queue trigger provenance; it is not multi-node distributed scheduling.
SCHEDULER_MODE=single_node_file_backed
TOPIC_SCHEDULER_RUNTIME_MODE=single_node_file_backed
# Horizontally distributed multi-node scheduler support is not implemented yet.
# Keep this false; true requests are reported as unsupported/degraded instead of pretending to work.
SCHEDULER_DISTRIBUTED=false
SCHEDULER_DISTRIBUTED_MODE=
TOPIC_SCHEDULER_ENABLED=true
TOPIC_SCHEDULER_TICK_SECONDS=5

# M11 legacy ownership migration
# Comma-separated stable product user ids that may preview/apply legacy run ownership migration.
ADMIN_USER_IDS=
# Comma-separated admin email allowlist for OIDC identities.
ADMIN_USER_EMAILS=

